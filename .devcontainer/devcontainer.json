{
	"name": "file-server 2.x",
	"image": "mcr.microsoft.com/devcontainers/base:noble",
	"mounts": [
		"type=bind,source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh/,target=/home/vscode/.ssh,readonly"
	],
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:4.1.0": {},
		"ghcr.io/devcontainers/features/node:2.1.0": {},
		"ghcr.io/devcontainers/features/java:1.8.2": {
			"installMaven": true,
			"version": "17",
			"jdkDistro": "tem",
			"additionalVersions": "21.0.7-tem"
		},
		"ghcr.io/devcontainers-extra/features/apt-packages:1": {
			"packages": [
				"libxtst6",
				"libxi6",
				"libxrender1",
				"graphviz",
				"tmux"
			]
		}
	},
	"containerUser": "vscode",
	"remoteUser": "vscode",
  "postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && npm install -g @openhands/agent-canvas",
  "postStartCommand": "tmux has-session -t canvas 2>/dev/null || (tmux new-session -d -s canvas && tmux send-keys -t canvas 'agent-canvas --port 7002' Enter)",
	"appPort": ["7002:7002"],
	"forwardPorts": [
		3000,
		5432,
		7002,
		8000,
		8080,
		8443
	],
	"customizations": {
		"vscode": {
			"settings": {
				"java.configuration.updateBuildConfiguration": "automatic",
				"java.compile.nullAnalysis.mode": "automatic",
				"sonarlint.ls.javaHome": "/usr/local/sdkman/candidates/java/21.0.7-tem/"
			},
			"extensions": [
				// "ms-azuretools.vscode-docker",
				"donjayamanne.githistory",
				"mhutchie.git-graph",
				"humao.rest-client",
				"qcz.text-power-tools",
				"berublan.vscode-log-viewer",
				"jebbs.plantuml",
				"tomoyukim.vscode-mermaid-editor",
				"yzhang.markdown-all-in-one",
				// "dbaeumer.vscode-eslint",
				// "vscjava.vscode-java-pack",
				"dhruv.maven-dependency-explorer",
				"sonarsource.sonarlint-vscode",
				"redhat.fabric8-analytics",
				"ms-ossdata.vscode-postgresql"
			]
		}
	}
}