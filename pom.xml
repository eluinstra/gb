  <properties>
    <checkstyle.cache.file>${project.build.directory}/checkstyle-cachefile</checkstyle.cache.file>
    <checkstyle.config.location>${basedir}/resources/reporting/checkstyle.xml</checkstyle.config.location>
    <checkstyle.header.file>${basedir}/resources/reporting/license.txt</checkstyle.header.file>
    <!-- Violation ceiling. The codebase is Checkstyle-clean, so this is 0 and the
         build fails on any violation. Raise it only to absorb a burst of pre-existing
         debt, then lower it back as it is fixed (see per-module overrides). -->
    <checkstyle.maxAllowedViolations>0</checkstyle.maxAllowedViolations>
    <!-- The root aggregator has no source; the 6 modules override this to false. -->
    <checkstyle.skip>true</checkstyle.skip>
    <!-- Classes excluded from checkstyle validation (Querydsl-backed entities), plus
         any plugin-generated sources (JAXB in the gb modules), which are never linted. -->
    <checkstyle.excludes>**/QFile.java,**/QUser.java,**/QUploadTask.java,**/QDownloadTask.java,**/generated-sources/**</checkstyle.excludes>
    <!-- The root aggregator has no source; the 6 modules override PMD/SpotBugs skip to false. -->
    <pmd.skip>true</pmd.skip>
    <spotbugs.skip>true</spotbugs.skip>
    <jdk.version>17</jdk.version>
    <revision>2.2.0</revision>
  </properties>
